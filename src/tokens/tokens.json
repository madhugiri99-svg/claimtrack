{
  "$description": "Mirrors the Figma variables in 'ClaimTrack Design System'. Names match Figma (slashes become dashes in CSS). Semantic colors alias primitives with {primitive/name}. Run `npm run tokens` after editing.",
  "primitives": {
    "navy/900": "#0F2A44",
    "teal/700": "#0B6564",
    "teal/600": "#0E7C7B",
    "teal/400": "#2BB3B1",
    "teal/50": "#E6F4F4",
    "gray/900": "#111827",
    "gray/600": "#5B6573",
    "gray/500": "#868E9C",
    "gray/200": "#E4E7EC",
    "gray/50": "#F5F7FA",
    "white": "#FFFFFF",
    "green/700": "#1F7A3E",
    "green/50": "#EAF5EE",
    "amber/700": "#9A5B00",
    "amber/50": "#FDF3E1",
    "red/700": "#B42318",
    "red/50": "#FDECEA",
    "blue/700": "#1D5FB8",
    "blue/50": "#EAF1FB"
  },
  "color": {
    "color/bg/page": "{gray/50}",
    "color/bg/surface": "{white}",
    "color/bg/brand": "{navy/900}",
    "color/bg/accent-subtle": "{teal/50}",
    "color/text/primary": "{navy/900}",
    "color/text/secondary": "{gray/600}",
    "color/text/inverse": "{white}",
    "color/text/link": "{teal/600}",
    "color/text/accent": "{teal/700}",
    "color/action/primary": "{teal/600}",
    "color/action/primary-hover": "{teal/700}",
    "color/action/secondary": "{white}",
    "color/border/default": "{gray/200}",
    "color/border/strong": "{gray/500}",
    "color/border/focus": "{blue/700}",
    "color/border/action": "{teal/600}",
    "color/decorative/brand-light": "{teal/400}",
    "color/status/approved/fg": "{green/700}",
    "color/status/approved/bg": "{green/50}",
    "color/status/pending/fg": "{amber/700}",
    "color/status/pending/bg": "{amber/50}",
    "color/status/denied/fg": "{red/700}",
    "color/status/denied/bg": "{red/50}",
    "color/status/review/fg": "{blue/700}",
    "color/status/review/bg": "{blue/50}"
  },
  "spacing": {
    "spacing/1": 4,
    "spacing/2": 8,
    "spacing/3": 12,
    "spacing/4": 16,
    "spacing/6": 24,
    "spacing/8": 32,
    "spacing/12": 48
  },
  "radius": {
    "radius/sm": 4,
    "radius/md": 8,
    "radius/lg": 16,
    "radius/full": 999
  },
  "typography": {
    "$description": "Mirrors the Figma text styles. Values are [weight, size px, line-height px].",
    "font/family": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "text/display": [700, 32, 40],
    "text/heading-lg": [600, 24, 32],
    "text/heading-md": [600, 20, 28],
    "text/body": [400, 16, 24],
    "text/body-strong": [600, 16, 24],
    "text/body-sm": [400, 14, 20],
    "text/label": [500, 14, 20],
    "text/caption": [500, 12, 16]
  }
}
